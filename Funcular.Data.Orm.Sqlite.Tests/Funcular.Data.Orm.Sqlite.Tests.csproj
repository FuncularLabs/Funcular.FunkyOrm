<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>MSB3277;MSB3247;MSB3268;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.*" />
    <PackageReference Include="MSTest.TestFramework" Version="3.*" />
    <PackageReference Include="coverlet.collector" Version="6.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Funcular.Data.Orm.Sqlite\Funcular.Data.Orm.Sqlite.csproj" />
    <ProjectReference Include="..\Funcular.Data.Orm.Core\Funcular.Data.Orm.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\..\Database\Sqlite\integration_test_schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Database\integration_test_schema.sql</Link>
    </None>
    <None Update="..\..\Database\Sqlite\integration_test_data.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Database\integration_test_data.sql</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The captured-value harnesses (docs/plans/WHERE_CAPTURED_VALUES_PLAN.md, §4.1), shared with SqlServer.Tests. -->
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\CapturedValues\TranslatorDirectHarness.cs" Link="CapturedValues\TranslatorDirectHarness.cs" />
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\CapturedValues\CapturedValueHarness.cs" Link="CapturedValues\CapturedValueHarness.cs" />
    <!-- WHERE parity rows (docs/plans/DECISIONS-3.10.2.md, D-001), shared with SqlServer.Tests. -->
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\Parity\WhereParityHarness.cs" Link="Parity\WhereParityHarness.cs" />
    <!-- Null semantics as EF Core answers them (3.12.0, docs/plans/NULL_SEMANTICS_PLAN.md), shared with SqlServer.Tests. -->
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\NullSemantics\NullSemanticsHarness.cs" Link="NullSemantics\NullSemanticsHarness.cs" />
    <!-- Aggregate correctness rows (3.11.0, FD-04), shared with SqlServer.Tests. -->
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\Aggregates\AggregateHarness.cs" Link="Aggregates\AggregateHarness.cs" />
  </ItemGroup>

</Project>
