<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <NoWarn>MSB3277;MSB3247;MSB3268;NU1701</NoWarn>
    <Copyright>Funcular Labs, Inc.</Copyright>
    <Description>MySQL provider for FunkyORM, a lightweight micro-ORM designed for simplicity and speed. Full LINQ-to-SQL, remote keys/properties, transactions, JSON querying, and reserved word handling. Entity classes and query code are portable between providers. Uses the MIT-licensed MySqlConnector driver. Supports .NET 8 and .NET Standard 2.0.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/FuncularLabs/Funcular.FunkyOrm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FuncularLabs/Funcular.FunkyOrm.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csharp;sql;orm;mysql;mariadb;entity;lambda;query</PackageTags>
    <Title>Funcular.FunkyORM.MySql</Title>
    <Version>3.14.0</Version>
    <AssemblyVersion>3.14.0.0</AssemblyVersion>
    <FileVersion>3.14.0.0</FileVersion>
    <InformationalVersion>3.14.0</InformationalVersion>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <GenerateTargetFrameworkMonikerAttribute>true</GenerateTargetFrameworkMonikerAttribute>
    <GenerateNuGetTargetMonikerAttribute>true</GenerateNuGetTargetMonikerAttribute>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Funcular.Data.Orm.MySql.Tests, </_Parameter1>
    </AssemblyAttribute>
    <!-- The cross-provider cache-scope tests (SqlServer.Tests/Caching) plant and observe this provider's caches. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Funcular.Data.Orm.SqlServer.Tests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Pinned minimum (FD-05): the version the provider compiles against and the Funcular.Data.Orm package declares.
       Change both together, and the README's provider table (PackagingTests pins the three). -->
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Funcular.Data.Orm.Core\Funcular.Data.Orm.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\docs\ai-instructions\FUNKYORM_AI_ADVANCED.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\Advanced.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <Content Include="..\docs\ai-instructions\FUNKYORM_AI_ADVANCED.md" Pack="true" PackagePath="contentFiles\any\any\FUNKYORM_AI_ADVANCED.md" BuildAction="None" CopyToOutput="false" Link="FUNKYORM_AI_ADVANCED.md" />
  </ItemGroup>

</Project>
