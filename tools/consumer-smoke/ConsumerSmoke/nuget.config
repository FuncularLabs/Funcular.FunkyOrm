<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The packed package comes from the local feed Run-ConsumerSmoke.ps1 fills; the drivers it declares come from
       nuget.org (or the machine's package cache) at the declared minimums. The source mapping keeps a user-level
       mapping (one that sends every package to nuget.org) from excluding the local feed. -->
  <!-- Packages go to a folder of their own next to this file, however the app is restored (the scripts also pass
       RestorePackagesPath): a Funcular.Data.Orm packed locally must never reach the machine's global cache, where it
       would shadow the published package of that version for every later restore (a local 3.11.0 did, 2026-10-14). -->
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="funky-local" value="%FUNKY_SMOKE_FEED%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="funky-local">
      <package pattern="Funcular.Data.Orm" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
