<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Funcular.Data.Orm.MySql\Funcular.Data.Orm.MySql.csproj" />
    <ProjectReference Include="..\Funcular.Data.Orm.Core\Funcular.Data.Orm.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AC7 rows of the provider-scoped caches plan, shared by the four providers' suites. -->
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\Caching\LinqScopeHarness.cs" Link="Caching\LinqScopeHarness.cs" />
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\DeleteGuard\DeleteGuardHarness.cs" Link="DeleteGuard\DeleteGuardHarness.cs" />
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\KeyParameters\KeyParameterHarness.cs" Link="KeyParameters\KeyParameterHarness.cs" />
    <!-- The captured-value harnesses (docs/plans/WHERE_CAPTURED_VALUES_PLAN.md, §4.1), shared with SqlServer.Tests. -->
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\CapturedValues\TranslatorDirectHarness.cs" Link="CapturedValues\TranslatorDirectHarness.cs" />
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\CapturedValues\CapturedValueHarness.cs" Link="CapturedValues\CapturedValueHarness.cs" />
    <!-- WHERE parity rows (docs/plans/DECISIONS-3.10.2.md, D-001), shared with SqlServer.Tests. -->
    <Compile Include="..\Funcular.Data.Orm.SqlServer.Tests\Parity\WhereParityHarness.cs" Link="Parity\WhereParityHarness.cs" />
  </ItemGroup>

</Project>
